PORT=3000
SMILES_CONCURRENCY=5

# Motor de transporte hacia Smiles:
#   auto (default) → arranca liviano (http) y si el WAF de Smiles devuelve 406
#                    cambia solo a un Chromium headless real (pasa el anti-bot).
#   http           → solo fetch de Node (rápido, pero suele dar 406).
#   browser        → siempre navegador headless.
# SMILES_ENGINE=auto

# Ruta a Chrome/Chromium para el motor navegador. Si no se define, usa el
# binario de @sparticuz/chromium (ideal para Render/servidores).
# SMILES_CHROME_PATH=/usr/bin/google-chrome

# Proxy residencial: necesario si desplegás en un servidor cuya IP de
# datacenter está bloqueada por el WAF de Smiles (Akamai). Enruta TODAS las
# consultas (motor http y browser) por la IP del proxy.
#   SMILES_PROXY=http://usuario:clave@host:puerto
# SMILES_PROXY=

# SMILES_API_KEY=
# SMILES_CURRENCY=ARS
# SMILES_REGION=ARGENTINA
